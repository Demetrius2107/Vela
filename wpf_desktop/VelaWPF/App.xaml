<Application x:Class="VelaWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <!-- 品牌色 -->
        <SolidColorBrush x:Key="VelaPrimary" Color="#FF4F6EF7"/>
        <SolidColorBrush x:Key="VelaPrimaryDark" Color="#FF3B57D9"/>
        <SolidColorBrush x:Key="VelaSuccess" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="VelaError" Color="#FFEF4444"/>
        <SolidColorBrush x:Key="VelaBg" Color="#FFF0F2F5"/>
        <SolidColorBrush x:Key="VelaTextPrimary" Color="#FF1A1A2E"/>
        <SolidColorBrush x:Key="VelaTextSecondary" Color="#FF999999"/>

        <!-- 会话个性色 -->
        <SolidColorBrush x:Key="Conv1" Color="#FF4F6EF7"/>
        <SolidColorBrush x:Key="Conv2" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="Conv3" Color="#FFEF4444"/>
        <SolidColorBrush x:Key="Conv4" Color="#FFF59E0B"/>

        <!-- 全局样式 -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource VelaPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFE8E8E8"/>
        </Style>
    </Application.Resources>
</Application>
