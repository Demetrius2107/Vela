<Window x:Class="VelaWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vela IM" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F2F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 会话列表 -->
        <Border Grid.Column="0" Background="White">
            <Grid>
                <TextBlock Text="Vela IM" FontSize="20" FontWeight="Bold"
                           Foreground="#FF4F6EF7" Margin="16,12,16,8"
                           VerticalAlignment="Top"/>
                <ListBox x:Name="ConversationList" Margin="0,48,0,0"
                         BorderThickness="0"
                         ItemsSource="{Binding Conversations}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 聊天区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="16,0">
                <TextBlock x:Name="ChatTitle" Text="选择一个会话" FontSize="16"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Background="#FFF5F5F5">
                <TextBlock Text="聊天内容区域" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="#FF999"/>
            </Border>

            <Border Grid.Row="2" Background="White" Padding="12,8">
                <Grid>
                    <TextBox x:Name="InputBox" Height="36" FontSize="14"
                             BorderBrush="#FFE8E8E8" VerticalAlignment="Center"/>
                    <Button Content="发送" Width="80" Height="36"
                            Background="#FF4F6EF7" Foreground="White"
                            HorizontalAlignment="Right"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
