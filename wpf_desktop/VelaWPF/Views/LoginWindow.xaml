<Window x:Class="VelaWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vela IM - 登录" Height="480" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF4F6EF7">
    <Grid>
        <Border CornerRadius="16" Background="White"
                Margin="30" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Vela IM" FontSize="28" FontWeight="Bold"
                           Foreground="#FF4F6EF7" TextAlignment="Center"/>
                <TextBlock Text="欢迎回来" FontSize="14"
                           Foreground="#FF999999" TextAlignment="Center"
                           Margin="0,8,0,24"/>

                <TextBlock Text="用户 ID" FontSize="12" Foreground="#FF666"/>
                <TextBox x:Name="UserIdBox" Margin="0,4,0,12" Height="40"
                         FontSize="14" BorderBrush="#FFE8E8E8"/>

                <TextBlock Text="密码" FontSize="12" Foreground="#FF666"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,20" Height="40"
                             FontSize="14" BorderBrush="#FFE8E8E8"/>

                <Button Content="登 录" Click="OnLoginClick"
                        Height="44" FontSize="16" FontWeight="SemiBold"
                        Background="#FF4F6EF7" Foreground="White"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="ErrorText" Foreground="#FFEF4444"
                           FontSize="13" Margin="0,8,0,0" TextAlignment="Center"/>

                <Button Content="没有账号？去注册" Click="OnRegisterClick"
                        FontSize="13" Foreground="#FF4F6EF7"
                        Background="Transparent" BorderThickness="0"
                        Margin="0,16,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
