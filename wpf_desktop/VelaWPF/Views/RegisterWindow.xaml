<Window x:Class="VelaWPF.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vela IM - 注册" Height="520" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF4F6EF7">
    <Grid>
        <Border CornerRadius="16" Background="White" Margin="30" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="创建账号" FontSize="26" FontWeight="Bold" Foreground="#FF4F6EF7" TextAlignment="Center"/>
                <TextBlock Text="加入 Vela IM" FontSize="13" Foreground="#FF999" TextAlignment="Center" Margin="0,4,0,20"/>

                <TextBlock Text="用户 ID" FontSize="12" Foreground="#FF666"/>
                <TextBox x:Name="UserIdBox" Margin="0,4,0,10" Height="38" FontSize="14" BorderBrush="#FFE8E8E8"/>

                <TextBlock Text="昵称" FontSize="12" Foreground="#FF666"/>
                <TextBox x:Name="NickNameBox" Margin="0,4,0,10" Height="38" FontSize="14" BorderBrush="#FFE8E8E8"/>

                <TextBlock Text="密码" FontSize="12" Foreground="#FF666"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,20" Height="38" FontSize="14" BorderBrush="#FFE8E8E8"/>

                <Button Content="注 册" Click="OnRegisterClick" Height="44" FontSize="16"
                        Background="#FF4F6EF7" Foreground="White" Cursor="Hand"/>

                <TextBlock x:Name="StatusText" FontSize="13" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
